{
  "name": "subscription-api",
  "version": "0.1.0",
  "private": true,
  "description": "Central subscription platform API",
  "main": "dist/server.js",
  "scripts": {
    "admin:create": "node scripts/create-admin.js",
    "service-token:create": "node scripts/create-service-token.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "db:apply": "node scripts/apply-database.js --write-api-env",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.2.0",
    "@types/pg": "^8.15.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
